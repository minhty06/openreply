[Unit]
Description=OpenReply DM worker
# Postgres and Redis run on this host now, so the worker must not start before
# them — its first act is to connect to both.
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target
Requires=postgresql.service redis-server.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/openreply
# Secrets live outside the repo so a git operation can never commit them.
EnvironmentFile=/etc/openreply/worker.env
# Heap cap so a long-running worker cannot grow into the memory Postgres and the
# web app need on this 1 GB host. See the budget in openreply-web.service.
Environment=NODE_OPTIONS=--max-old-space-size=192
ExecStart=/usr/bin/npm run worker
# The queue consumer must come back on its own after a crash, an OOM kill, or a
# host reboot — that is the whole reason for moving off a laptop.
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=openreply-worker

# The worker only makes outbound connections, so it needs no privileges and no
# write access outside its own directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/openreply

[Install]
WantedBy=multi-user.target
