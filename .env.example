# App
# Comma-separated login allowlist. Unset = open signup (anyone can register).
ALLOWED_EMAILS=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-strong-random-secret
CRON_SECRET=replace-with-a-strong-random-secret
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database / queue
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/openreply
REDIS_URL=redis://localhost:6379

# Email magic links (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=OpenReply <login@example.com>

# Meta / Instagram
META_GRAPH_API_VERSION=v25.0
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
FACEBOOK_APP_SECRET=your-facebook-app-secret
WEBHOOK_VERIFY_TOKEN=replace-with-a-webhook-verify-token

# Comment polling (worker only)
# How often the reconciler sweeps for comments webhooks missed. Note that a
# 5-minute sweep also keeps a serverless Postgres permanently awake, which is
# what exhausts a metered free tier — raise this if you pay by compute-hour.
# COMMENT_POLL_INTERVAL_MS=300000
# COMMENT_POLL_LOOKBACK_HOURS=72
# COMMENT_POLL_MAX_PER_SWEEP=30

# Retention (see lib/ops/retention.ts). Defaults shown; all optional.
# WebhookEvent is raw diagnostic exhaust and by far the biggest table.
# RETENTION_WEBHOOK_EVENT_DAYS=7
# RETENTION_LINK_CLICK_DAYS=30
# RETENTION_OPERATIONAL_EVENT_DAYS=30
# DmLog is kept much longer: the shared campaign reports read lifetime totals
# from it, and it is the reconciler's idempotency ledger. Values below 4 days are
# clamped up, because deleting a row inside the reconciler's lookback window
# makes the next sweep DM that person a second time.
# RETENTION_DM_LOG_DAYS=90
